    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@mysten/sui": "2.38.0",
    "@fastify/rate-limit": "11.2.1",
    "@puc/aftermath": "0.1.0",
    "@puc/core": "0.1.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13"
  }
}
