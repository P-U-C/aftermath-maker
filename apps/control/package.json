{
  "name": "@puc/control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
