# Runtime
NODE_ENV=production
CONTROL_HOST=0.0.0.0
CONTROL_PORT=8787
WEB_PORT=8788
CONTROL_URL=http://control:8787
DATABASE_PATH=./data/maker.db

# Create with: openssl rand -base64 32
# Required before provisioning an agent signer.
MAKER_MASTER_KEY=

# Long random token required between the web and control containers.
CONTROL_TOKEN=

# Canonical origin bound into every wallet login message.
PUBLIC_ORIGIN=https://maker.permanentupperclass.com

# Enable only while Basic Auth protects the first operator login. Disable after
# the on-chain registry is deployed and SUI_WHITELIST_OBJECT_ID is recorded.
WALLET_AUTH_BOOTSTRAP=false
SUI_WHITELIST_OBJECT_ID=

# Permissionless Aftermath builder registration supplies this numeric ID.
# One basis point = 0.01% of filled notional; the UI discloses the exact cap.
AFTERMATH_INTEGRATOR_ID=
AFTERMATH_INTEGRATOR_FEE_BPS=1

# Trading is fail-closed until both values are explicitly enabled.
LIVE_TRADING_ENABLED=false
ALLOW_MAINNET=false

# Preferred direct validator/fullnode gRPC endpoint. Kept local.
SUI_VALIDATOR_GRPC_URL=

# Public fallback, used only when the preferred endpoint is unhealthy.
SUI_FALLBACK_GRPC_URL=https://fullnode.mainnet.sui.io:443
